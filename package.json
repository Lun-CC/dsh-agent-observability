{
  "name": "dsh-audit-plugin",
  "version": "1.0.1",
  "description": "会话成本审计：看看一次对话的 token 花在哪、哪一步贵，并把优化建议做成一键可应用的修改。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lun-CC/dsh-agent-observability.git"
  },
  "homepage": "https://github.com/Lun-CC/dsh-agent-observability#readme",
  "bugs": {
    "url": "https://github.com/Lun-CC/dsh-agent-observability/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-audit": "bin/dsh-audit.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "icon",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "icon",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "observability",
    "token-cost",
    "cost-audit",
    "session-log",
    "zstd"
  ],
  "author": "lun",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
