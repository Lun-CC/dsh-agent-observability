{
  "name": "dsh-audit-plugin",
  "version": "1.0.0",
  "description": "会话成本审计：按平台定价逐节点归因 token 成本并给出处方。Session cost audit for DeepSeek Harness: per-node token attribution via ctx.tokenMeter, then prescriptions.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lun-CC/dsh-agent-observability.git",
    "directory": "packages/dsh-audit-plugin"
  },
  "homepage": "https://github.com/Lun-CC/dsh-agent-observability/tree/main/packages/dsh-audit-plugin#readme",
  "bugs": {
    "url": "https://github.com/Lun-CC/dsh-agent-observability/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-audit": "bin/dsh-audit.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "icon"
  ],
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "icon",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "observability",
    "token-cost",
    "cost-audit",
    "zstd",
    "session-log"
  ],
  "author": "lun",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/sync-core.mjs && node ../../scripts/prepare-pack.mjs && node ../../scripts/verify-pack.mjs",
    "postpack": "node ../../scripts/cleanup-pack.mjs"
  }
}
